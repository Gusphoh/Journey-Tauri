{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Club Penguin Journey",
  "version": "1.0.0",
  "identifier": "net.cpjourney.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Club Penguin Journey",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Lanzador de Club Penguin Journey",
    "category": "Game",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
